generator client {
  provider        = "prisma-client-js"
  // Load relations with SQL joins (one round trip) instead of one query per include.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TeamRole {
  SYSTEM_OWNER
  SYSTEM_ADMIN
  MEMBER
}

enum ProjectRole {
  PROJECT_MANAGER
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  SENT
  FAILED
  ACCEPTED
  REVOKED
}

enum BroadcastStatus {
  NOT_STARTED
  CONTACTED
  NEGOTIATING
  AWAITING_RESPONSE
  PUBLISHED
  DECLINED
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  email     String   @unique
  name      String
  role      TeamRole @default(MEMBER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  projectMemberships ProjectMember[]
  activityLogs ActivityLog[]
  createdProjects Project[] @relation("ProjectCreator")
  createdTasks TeamTask[] @relation("TaskReporter")
  assignedTasks TaskAssignee[] @relation("TaskAssignee")
  taskAssignmentsMade TaskAssignee[] @relation("TaskAssignor")
  taskComments TaskComment[]
  invitationsCreated TeamInvitation[] @relation("InvitationCreator")
  departments TeamMemberDepartment[]
  departmentAssignmentsMade TeamMemberDepartment[] @relation("DepartmentAssigner")
  createdMarketingPartnerships MarketingPartnership[] @relation("MarketingPartnershipCreator")
  updatedMarketingPartnerships MarketingPartnership[] @relation("MarketingPartnershipUpdater")

  @@map("team_members")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  departmentId String  @map("department_id")
  hasPartnershipSheet Boolean @default(false) @map("has_partnership_sheet")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdById String   @map("created_by_id")
  version     Int      @default(1)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  members     ProjectMember[]
  activityLogs ActivityLog[]
  createdBy   TeamMember @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  department  Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  tasks       TeamTask[]
  partnerships MarketingPartnership[]

  @@index([departmentId, archivedAt, updatedAt])
  @@index([archivedAt, updatedAt])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  id           String      @id @default(cuid())
  projectId    String      @map("project_id")
  teamMemberId String      @map("team_member_id")
  role         ProjectRole @default(MEMBER)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMember   TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)

  @@unique([projectId, teamMemberId])
  @@index([teamMemberId, isActive])
  @@map("project_members")
}

model ActivityLog {
  id               String      @id @default(cuid())
  actorTeamMemberId String     @map("actor_team_member_id")
  projectId        String?     @map("project_id")
  eventType        String      @map("event_type")
  entityType       String      @map("entity_type")
  entityId         String      @map("entity_id")
  metadata         Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  actor            TeamMember  @relation(fields: [actorTeamMemberId], references: [id], onDelete: Restrict)
  project          Project?    @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt, id])
  @@index([createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@index([actorTeamMemberId])
  @@map("activity_logs")
}

model TeamTask {
  id                    String       @id @default(cuid())
  projectId             String?      @map("project_id")
  departmentId          String?      @map("department_id")
  partnershipId         String?      @map("partnership_id")
  title                 String
  description           String?
  attachments           String[]     @default([])
  status                TaskStatus   @default(TODO)
  priority              TaskPriority @default(NORMAL)
  dueAt                 DateTime?    @map("due_at")
  createdByTeamMemberId String       @map("created_by_team_member_id")
  version               Int          @default(1)
  archivedAt            DateTime?    @map("archived_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  department            Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  partnership           MarketingPartnership? @relation(fields: [partnershipId], references: [id], onDelete: SetNull)
  createdBy             TeamMember   @relation("TaskReporter", fields: [createdByTeamMemberId], references: [id], onDelete: Restrict)
  assignees             TaskAssignee[]
  comments              TaskComment[]

  @@index([projectId, status, archivedAt, updatedAt])
  @@index([projectId, archivedAt, updatedAt])
  @@index([departmentId, archivedAt, updatedAt])
  @@index([partnershipId, archivedAt])
  @@index([createdByTeamMemberId, archivedAt])
  @@map("tasks")
}

model TaskAssignee {
  id                String     @id @default(cuid())
  taskId            String     @map("task_id")
  teamMemberId      String     @map("team_member_id")
  assignedByMemberId String    @map("assigned_by_member_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  task              TeamTask   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  teamMember        TeamMember @relation("TaskAssignee", fields: [teamMemberId], references: [id], onDelete: Restrict)
  assignedBy        TeamMember @relation("TaskAssignor", fields: [assignedByMemberId], references: [id], onDelete: Restrict)

  @@unique([taskId, teamMemberId])
  @@index([teamMemberId, taskId])
  @@index([assignedByMemberId])
  @@map("task_assignees")
}

model TaskComment {
  id             String     @id @default(cuid())
  taskId         String     @map("task_id")
  authorMemberId String     @map("author_member_id")
  body           String
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  task           TeamTask   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author         TeamMember @relation(fields: [authorMemberId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([authorMemberId])
  @@map("task_comments")
}

model TeamInvitation {
  id                    String           @id @default(cuid())
  email                 String
  role                  TeamRole         @default(MEMBER)
  tokenHash             String           @unique @map("token_hash")
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime         @map("expires_at")
  acceptedAt            DateTime?        @map("accepted_at")
  revokedAt             DateTime?        @map("revoked_at")
  createdByTeamMemberId String           @map("created_by_team_member_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  createdBy             TeamMember       @relation("InvitationCreator", fields: [createdByTeamMemberId], references: [id], onDelete: Restrict)

  @@index([email, status, expiresAt])
  @@index([status, createdAt])
  @@index([createdByTeamMemberId])
  @@map("team_invitations")
}

model Department {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  description String?
  isActive    Boolean                @default(true) @map("is_active")
  version     Int                    @default(1)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  members     TeamMemberDepartment[]
  projects    Project[]
  tasks       TeamTask[]
  marketingPartnerships MarketingPartnership[]

  @@index([isActive, name])
  @@map("departments")
}

model MarketingPartnership {
  id              String          @id @default(cuid())
  name            String
  category        String          @default("Creator")
  platform        String          @default("X")
  totalMembers    Int             @default(0) @map("total_members")
  picName         String?         @map("pic_name")
  picContact      String?         @map("pic_contact")
  broadcastStatus BroadcastStatus @default(NOT_STARTED) @map("broadcast_status")
  followUpDate    DateTime?       @map("follow_up_date")
  notes           String?
  projectId       String?         @map("project_id")
  departmentId    String?         @map("department_id")
  createdById     String?         @map("created_by_id")
  updatedById     String?         @map("updated_by_id")
  sortOrder       Int             @default(0) @map("sort_order")
  version         Int             @default(1)
  archivedAt      DateTime?       @map("archived_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  TeamMember? @relation("MarketingPartnershipCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  TeamMember? @relation("MarketingPartnershipUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  tasks      TeamTask[]

  @@index([archivedAt, sortOrder, createdAt])
  @@index([projectId, archivedAt])
  @@index([broadcastStatus, archivedAt])
  @@index([platform, archivedAt])
  @@index([followUpDate, archivedAt])
  @@index([departmentId])
  @@map("marketing_partnerships")
}

model TeamMemberDepartment {
  id                    String     @id @default(cuid())
  departmentId          String     @map("department_id")
  teamMemberId          String     @map("team_member_id")
  assignedByTeamMemberId String    @map("assigned_by_team_member_id")
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  department            Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teamMember            TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)
  assignedBy            TeamMember @relation("DepartmentAssigner", fields: [assignedByTeamMemberId], references: [id], onDelete: Restrict)

  @@unique([departmentId, teamMemberId])
  @@index([teamMemberId, isActive])
  @@index([assignedByTeamMemberId])
  @@map("team_member_departments")
}
