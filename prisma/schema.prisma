generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["team_platform"]
}

enum TeamRole {
  SYSTEM_OWNER
  SYSTEM_ADMIN
  MEMBER

  @@schema("team_platform")
}

enum ProjectRole {
  PROJECT_MANAGER
  MEMBER
  VIEWER

  @@schema("team_platform")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE

  @@schema("team_platform")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@schema("team_platform")
}

enum InvitationStatus {
  PENDING
  SENT
  FAILED
  ACCEPTED
  REVOKED

  @@schema("team_platform")
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  email     String   @unique
  name      String
  role      TeamRole @default(MEMBER)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  projectMemberships ProjectMember[]
  activityLogs ActivityLog[]
  createdProjects Project[] @relation("ProjectCreator")
  createdTasks TeamTask[] @relation("TaskReporter")
  assignedTasks TaskAssignee[] @relation("TaskAssignee")
  taskAssignmentsMade TaskAssignee[] @relation("TaskAssignor")
  taskComments TaskComment[]
  invitationsCreated TeamInvitation[] @relation("InvitationCreator")
  departments TeamMemberDepartment[]
  departmentAssignmentsMade TeamMemberDepartment[] @relation("DepartmentAssigner")

  @@map("team_members")
  @@schema("team_platform")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdById String   @map("created_by_id")
  version     Int      @default(1)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  members     ProjectMember[]
  activityLogs ActivityLog[]
  createdBy   TeamMember @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       TeamTask[]

  @@index([archivedAt, updatedAt])
  @@map("projects")
  @@schema("team_platform")
}

model ProjectMember {
  id           String      @id @default(cuid())
  projectId    String      @map("project_id")
  teamMemberId String      @map("team_member_id")
  role         ProjectRole @default(MEMBER)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  teamMember   TeamMember  @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)

  @@unique([projectId, teamMemberId])
  @@index([teamMemberId, isActive])
  @@map("project_members")
  @@schema("team_platform")
}

model ActivityLog {
  id               String      @id @default(cuid())
  actorTeamMemberId String     @map("actor_team_member_id")
  projectId        String?     @map("project_id")
  eventType        String      @map("event_type")
  entityType       String      @map("entity_type")
  entityId         String      @map("entity_id")
  metadata         Json?
  createdAt        DateTime    @default(now()) @map("created_at")
  actor            TeamMember  @relation(fields: [actorTeamMemberId], references: [id], onDelete: Restrict)
  project          Project?    @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt, id])
  @@index([createdAt, id])
  @@index([entityType, entityId, createdAt])
  @@map("activity_logs")
  @@schema("team_platform")
}

model TeamTask {
  id                    String       @id @default(cuid())
  projectId             String       @map("project_id")
  title                 String
  description           String?
  status                TaskStatus   @default(TODO)
  priority              TaskPriority @default(NORMAL)
  dueAt                 DateTime?    @map("due_at")
  createdByTeamMemberId String       @map("created_by_team_member_id")
  version               Int          @default(1)
  archivedAt            DateTime?    @map("archived_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  project               Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy             TeamMember   @relation("TaskReporter", fields: [createdByTeamMemberId], references: [id], onDelete: Restrict)
  assignees             TaskAssignee[]
  comments              TaskComment[]

  @@index([projectId, status, archivedAt, updatedAt])
  @@index([createdByTeamMemberId, archivedAt])
  @@map("tasks")
  @@schema("team_platform")
}

model TaskAssignee {
  id                String     @id @default(cuid())
  taskId            String     @map("task_id")
  teamMemberId      String     @map("team_member_id")
  assignedByMemberId String    @map("assigned_by_member_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  task              TeamTask   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  teamMember        TeamMember @relation("TaskAssignee", fields: [teamMemberId], references: [id], onDelete: Restrict)
  assignedBy        TeamMember @relation("TaskAssignor", fields: [assignedByMemberId], references: [id], onDelete: Restrict)

  @@unique([taskId, teamMemberId])
  @@index([teamMemberId, taskId])
  @@map("task_assignees")
  @@schema("team_platform")
}

model TaskComment {
  id             String     @id @default(cuid())
  taskId         String     @map("task_id")
  authorMemberId String     @map("author_member_id")
  body           String
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  task           TeamTask   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author         TeamMember @relation(fields: [authorMemberId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_comments")
  @@schema("team_platform")
}

model TeamInvitation {
  id                    String           @id @default(cuid())
  email                 String
  role                  TeamRole         @default(MEMBER)
  tokenHash             String           @unique @map("token_hash")
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime         @map("expires_at")
  acceptedAt            DateTime?        @map("accepted_at")
  revokedAt             DateTime?        @map("revoked_at")
  createdByTeamMemberId String           @map("created_by_team_member_id")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  createdBy             TeamMember       @relation("InvitationCreator", fields: [createdByTeamMemberId], references: [id], onDelete: Restrict)

  @@index([email, status, expiresAt])
  @@index([status, createdAt])
  @@map("team_invitations")
  @@schema("team_platform")
}

model Department {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  description String?
  isActive    Boolean                @default(true) @map("is_active")
  version     Int                    @default(1)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  members     TeamMemberDepartment[]

  @@index([isActive, name])
  @@map("departments")
  @@schema("team_platform")
}

model TeamMemberDepartment {
  id                    String     @id @default(cuid())
  departmentId          String     @map("department_id")
  teamMemberId          String     @map("team_member_id")
  assignedByTeamMemberId String    @map("assigned_by_team_member_id")
  isActive              Boolean    @default(true) @map("is_active")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  department            Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teamMember            TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)
  assignedBy            TeamMember @relation("DepartmentAssigner", fields: [assignedByTeamMemberId], references: [id], onDelete: Restrict)

  @@unique([departmentId, teamMemberId])
  @@index([teamMemberId, isActive])
  @@map("team_member_departments")
  @@schema("team_platform")
}
