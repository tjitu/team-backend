# Runtime connections use the transaction-mode pooler (port 6543).
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[TRANSACTION_POOLER_HOST]:6543/postgres?pgbouncer=true&schema=team_platform&sslmode=require
# Prisma migrations and database backups use the session-mode pooler (port 5432).
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@[SESSION_POOLER_HOST]:5432/postgres?schema=team_platform&sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
TEAM_FRONTEND_ORIGIN=http://localhost:3100
TEAM_OWNER_USER_ID=
TEAM_OWNER_EMAIL=
TEAM_OWNER_NAME=
# Optional read-only PostgreSQL connection to Jitu's internal payments database.
JITU_PURCHASES_DATABASE_URL=
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Team Platform <noreply@example.com>
